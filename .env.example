# Copy this file to .env and fill in fake/local values.
# Never commit a real .env or a real API key.

# Server
PORT=3000
NODE_ENV=development

# SQLite database file (relative to backend/prisma)
DATABASE_URL="file:./dev.db"

# LLM provider. "fake" runs the deterministic offline model; "gemini" calls a real model.
# Supported: fake | gemini
LLM_PROVIDER=fake
# fake-triage-v1 for the fake model, a Gemini model id for gemini (empty = gemini-2.5-flash)
LLM_MODEL=fake-triage-v1
# Free key from https://aistudio.google.com (only needed when LLM_PROVIDER=gemini)
LLM_API_KEY=replace-with-your-key
# Optional: any OpenAI-compatible endpoint. Default is Gemini's own compatible endpoint.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MAX_TOOL_CALLS=5
LLM_TIMEOUT_MS=15000

# Session secret for the demo role switch (synthetic users only)
SESSION_SECRET=change-me-local-only
