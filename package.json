{
  "name": "campus-triage-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Campus Maintenance Ticket Triage Agent — SWE 485 project",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "npm run lint && vite build --config frontend/vite.config.ts",
    "start": "tsx backend/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
